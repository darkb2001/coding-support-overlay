# Meeting STT: Speechmatics Realtime by default. Audio goes to Speechmatics.
# Thiết lập lần đầu: copy file này thành .env, điền key Speechmatics của bạn.
# Chỉ commit .env.example với key trống; không commit/chia sẻ .env hoặc .env.local.
# Sau khi sửa .env, Quit và mở lại overlay (refresh UI không nạp lại key).
# Hướng dẫn chi tiết: README.md → Thiết lập STT key qua .env.
MEETING_STT_BACKEND=speechmatics
SPEECHMATICS_API_KEY=
# enhanced: explicit vi/en, IT vocabulary, live language switch inside the same Meeting.
# Optional melia-1: automatic Vietnamese/English multilingual (reduced feature set).
SPEECHMATICS_MODEL=enhanced
# Fixed trusted endpoint region: global, eu, us, au (no custom URLs).
SPEECHMATICS_REGION=global

# To use the old segmented Whisper/Groq path, explicitly set:
# MEETING_STT_BACKEND=legacy
# Local Whisper (adjust paths; uncomment both):
# WHISPER_CLI=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
# Optional: defaults to whisper-server alongside WHISPER_CLI.
# WHISPER_SERVER=/opt/homebrew/bin/whisper-server

# Cloud STT alternative (audio is sent to Groq):
# GROQ_API_KEY=your_groq_key
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Legacy STT default (Meeting language dropdown takes precedence).
# Melia always recognizes Vietnamese/English; dropdown selects answer language.
MEETING_STT_LANG=auto

# AI reply hints use codingSupport.apiKey/model in Cursor extension settings,
# not CURSOR_API_KEY in this file.
